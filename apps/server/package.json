{
  "name": "server",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc -b",
    "compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "npm run test:setup && npx vitest run",
    "test:watch": "npx vitest",
    "test:setup": "npx tsx __tests__/setup-db.ts"
  },
  "dependencies": {
    "@festas/auth": "*",
    "@festas/db": "*",
    "@saas/shared-types": "*",
    "@types/winston": "^2.4.4",
    "better-auth": "^1.3.13",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.4.1",
    "i18next": "^25.7.1",
    "i18next-fs-backend": "^2.6.1",
    "multer": "^2.1.1",
    "winston": "^3.18.3",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.13.11",
    "tsdown": "^0.15.5",
    "tsx": "^4.19.2",
    "typescript": "^5.8.2",
    "vitest": "^4.1.5"
  }
}
