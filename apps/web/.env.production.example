# ============================================================
# Production Environment (cPanel) - Example
# ============================================================
# Copiar para .env.production (é este ficheiro que o `npm run deploy`
# empacota como apps/web/.env no bundle). NUNCA commitar o real.

# ─── App URLs ─────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://baselandia.pt

# ─── Database ────────────────────────────────────────────────
# No servidor cPanel usar "localhost" (mesma máquina).
# connection_limit=5 limita o pool do Prisma (o defeito num_cpus*2+1
# abre dezenas de ligações em shared hosting). O build-deploy.mjs
# acrescenta estes parâmetros automaticamente se faltarem.
DATABASE_URL=mysql://UTILIZADOR_BD:PASSWORD_BD@localhost:3306/baselandia_prod?connection_limit=5&pool_timeout=10

# ─── Better Auth ─────────────────────────────────────────────
# Gerar com: openssl rand -base64 32
BETTER_AUTH_SECRET=<NOVO_SECRET>
BETTER_AUTH_URL=https://baselandia.pt

# ─── Cookies ─────────────────────────────────────────────────
# Se o cPanel serve HTTPS normal, deixar assim.
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# ─── Email (Mailjet) ─────────────────────────────────────────
MAILJET_API_KEY=
MAILJET_API_SECRET=
MAILJET_SENDER_EMAIL=
MAILJET_SENDER_NAME=

# ─── Runtime ─────────────────────────────────────────────────
# Thread pool do libuv (fs/DNS). O app.js fixa 4 por defeito.
# UV_THREADPOOL_SIZE=4
