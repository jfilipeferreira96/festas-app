# ============================================================
# Example Environment Variables
# ============================================================
# Copy this file to .env and fill in the actual values

# ─── App URLs ─────────────────────────────────────────────────
NEXT_PUBLIC_SERVER_URL=http://localhost:5555
NEXT_PUBLIC_APP_URL=http://localhost:4444

# ─── Database ────────────────────────────────────────────────
DATABASE_URL=mysql://user:password@localhost:3306/festas
DATABASE_URL_TEST=mysql://user:password@localhost:3306/festas_test

# ─── Better Auth ─────────────────────────────────────────────
BETTER_AUTH_SECRET=your-secret-key-here
BETTER_AUTH_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# ─── Cookies ─────────────────────────────────────────────────
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# ─── Seed Configurations ───────────────────────────────────────
# Email domain para utilizadores de seed
SEED_EMAIL_DOMAIN=domain.pt

# Password default para todos os utilizadores de seed
SEED_USER_PASSWORD=example!2025

# Passwords específicas por role (opcional - se não definidas, usa SEED_USER_PASSWORD)
# SEED_ADMIN_PASSWORD=
# SEED_LANCHE_PASSWORD=
# SEED_CACIFOS_PASSWORD=
# SEED_MONITOR_PASSWORD=
# SEED_FESTAS_ACABAR_PASSWORD=
# SEED_STAFF_PASSWORD=
# SEED_RECECAO_PASSWORD=
