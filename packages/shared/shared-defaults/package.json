{
  "name": "@saas/shared-defaults",
  "version": "1.0.0",
  "type": "module",
  "description": "Shared default configurations for the Festas platform",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./src/*.ts"
    }
  },
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "build": "tsdown"
  },
  "dependencies": {
    "@saas/shared-types": "*"
  },
  "devDependencies": {
    "tsdown": "^0.15.5",
    "typescript": "^5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jfilipeferreira96/saas.git",
    "directory": "packages/shared/shared-defaults"
  },
  "keywords": [
    "typescript",
    "defaults",
    "festas",
    "monorepo"
  ],
  "author": "Filipe Ferreira",
  "license": "MIT"
}
