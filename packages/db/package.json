{
  "name": "@festas/db",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "build": "tsdown",
    "db:generate": "node scripts/db.js generate",
    "db:push": "node scripts/db.js push",
    "db:push:force": "node scripts/db.js push:force",
    "db:migrate": "node scripts/db.js migrate",
    "db:studio": "node scripts/db.js studio",
    "db:reset": "node scripts/db.js reset",
    "db:clean": "node scripts/db.js clean",
    "db:seed": "node scripts/db.js seed",
    "db:seed:dev": "node scripts/db.js seed:dev",
    "db:refresh": "node scripts/db.js clean",
    "db:sync": "node scripts/db.js migrate && node scripts/db.js generate",
    "db:inspect": "node scripts/db.js generate && node scripts/db.js studio"
  },
  "devDependencies": {
    "prisma": "^6.15.0",
    "tsdown": "^0.15.5",
    "tsx": "^4.19.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@faker-js/faker": "^10.1.0",
    "@prisma/client": "^6.15.0",
    "bcryptjs": "^3.0.2",
    "better-auth": "^1.3.13",
    "dotenv": "^17.2.2",
    "zod": "^4.1.11"
  }
}