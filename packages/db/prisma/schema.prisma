generator client {
  provider      = "prisma-client-js"
  // Gerar engines para dev (Windows = native) E para o servidor cPanel (Linux/AlmaLinux).
  // Inclui RHEL e DEBIAN (o servidor cPanel usa debian-openssl-1.0.x).
  // Para confirmar o alvo exato no servidor: `npx prisma -v` (mostra o "Binary Types").
  binaryTargets = ["native", "rhel-openssl-3.0.x", "rhel-openssl-1.1.x", "debian-openssl-1.0.x", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============================================
// AUTH — Better Auth core tables
// ============================================

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Party management specific fields
  funcao        FuncaoUtilizador @default(ADMINISTRADOR)
  activo        Boolean          @default(true)

  sessions      Session[]
  accounts      Account[]
  monitor       Monitor?
  auditLogs     AuditLog[]
  notasRapidas  NotaRapida[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
}

// ============================================
// ENUMS
// ============================================

enum FuncaoUtilizador {
  ADMINISTRADOR
  LANCHE
  CACIFOS
  MONITOR
  FESTAS_ACABAR
  STAFF
  RECECAO
}

enum EstadoReserva {
  RESERVA
  CONFIRMADO
  EM_CURSO
  CONCLUIDA
  CANCELADA
}

enum EstadoCacifo {
  LIVRE
  OCUPADO
  RESERVADO
}

enum MetodoPagamento {
  DINHEIRO
  MULTIBANCO
  MBWAY
  TRANSFERENCIA
  CARTAO
  OUTRO
}

enum EstadoCaucao {
  PAGA
  NAO_PAGA
  PAGA_NO_DIA
}

enum CategoriaItem {
  MENU
  EXTRA
}

enum TipoCampanha {
  EMAIL
  SMS
}

enum EstadoCampanha {
  RASCUNHO
  AGENDADA
  ENVIADA
  CANCELADA
}

enum EstadoEntradaLivre {
  ATIVA
  CONCLUIDA
  CANCELADA
}

enum EstadoLanche {
  NAO_INICIADO
  A_DECORRER
  TERMINADO
}

enum TipoExcecaoCalendario {
  FERIADO
  BLOQUEADO
}

enum TipoBolo {
  PAIS_TRAZEM       // "Pais trazem o bolo"
  NOSSO_1KG         // "Nosso bolo 1kg"
  NOSSO_2KG         // "Nosso bolo 2kg"
  BOLO_ARTISTICO    // "Bolo artístico"
  A_DECIDIR         // "Ainda vão decidir"
}

// ============================================
// CLIENTES & ANIVERSARIANTES
// ============================================

model Cliente {
  id             String   @id @default(cuid())
  nome           String
  contribuinte   String?
  email          String?  @unique
  telefone       String
  codigoPostal   String?
  observacao     String?  @db.Text
  optOut         Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  aniversariantes     Aniversariante[]
  reservas            Reserva[]
  entradasLivres      EntradaLivre[]
  newsletterContacto  NewsletterContacto?

  @@map("cliente")
}

model Aniversariante {
  id             String   @id @default(cuid())
  nome           String
  dataNascimento DateTime?
  observacoes    String?  @db.Text
  clienteId      String
  cliente        Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  reservas       ReservaAniversariante[]

  @@map("aniversariante")
}

// ============================================
// LOCAIS (Salas / Espaços)
// ============================================

model Local {
  id         String   @id @default(cuid())
  nome       String
  activo     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  reservas      Reserva[]
  extras        ExtraLocal[]
  alocacoes     AlocacaoMonitor[]

  @@map("local")
}

// ============================================
// EXTRAS
// ============================================

model Extra {
  id            String        @id @default(cuid())
  nome          String
  descricao     String?       @db.Text
  precoUnitario Decimal       @db.Decimal(10, 2)
  icone         String?
  categoria     CategoriaItem @default(EXTRA)
  subcategoria  String?       // Ex: "Diversão", "Premium" — para agrupar extras no formulário
  requerTexto   Boolean       @default(false) // Se true, mostra input de texto ao selecionar
  // Flag para menus: true = apenas fim-de-semana/feriados, false = apenas dias de semana, null = todos os dias
  fimDeSemana   Boolean?
  activo        Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  reservas      ReservaExtra[]
  locais        ExtraLocal[]
  entradasLivres EntradaLivreExtra[]

  @@map("extra")
}

model ExtraLocal {
  id       String @id @default(cuid())
  extraId  String
  localId  String
  extra    Extra  @relation(fields: [extraId], references: [id], onDelete: Cascade)
  local    Local  @relation(fields: [localId], references: [id], onDelete: Cascade)

  @@unique([extraId, localId])
  @@map("extra_local")
}

// ============================================
// MONITORES
// ============================================

model Monitor {
  id        String   @id @default(cuid())
  nome      String
  contacto  String
  fotoUrl   String?
  activo    Boolean  @default(true)
  // Valor que o monitor recebe por hora (para cálculo de vencimento mensal)
  valorHora Decimal? @db.Decimal(10, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Optional link to a system user
  userId    String?  @unique
  user      User?    @relation(fields: [userId], references: [id])

  reservas  ReservaMonitor[]
  alocacoes AlocacaoMonitor[]

  @@map("monitor")
}

// ============================================
// ALOCAÇÃO DE MONITORES (escalação por dia + intervalo horário)
// ============================================

model AlocacaoMonitor {
  id          String   @id @default(cuid())
  data        DateTime             // O dia (filtrado por range gte/lt, como Reserva.data)
  horaInicio  Int                  // Minutos desde meia-noite (0–1440). Ex.: 14h = 840
  horaFim     Int                  // Minutos desde meia-noite
  observacoes String?  @db.Text
  monitorId   String
  localId     String
  monitor     Monitor  @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  local       Local    @relation(fields: [localId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([data])
  @@index([monitorId, data])
  @@map("alocacao_monitor")
}

// ============================================
// CONFIGURAÇÃO DE CACIFOS
// ============================================

model ConfiguracaoCacifo {
  id           String   @id @default(cuid())
  totalCacifos Int      @default(200)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  cacifos      Cacifo[]

  @@map("configuracao_cacifo")
}

// ============================================
// CONFIGURAÇÃO DE PREÇOS (singleton global)
// ============================================
// Um único tarifário para toda a aplicação.
// Preço POR CRIANÇA (festa); Entrada Livre = preço por hora.
// Distingue dia de semana vs fim de semana vs feriado (feriado usa tarifa fim-semana).
// Mínimos de crianças por nº de aniversariantes (1→10, 2→15, 3→20).

model ConfiguracaoPreco {
  id                            String   @id @default(cuid())
  // Preço POR CRIANÇA (festa)
  precoCriancaSemana            Decimal  @db.Decimal(10, 2) @default(15)
  precoCriancaFimSemana         Decimal  @db.Decimal(10, 2) @default(20)
  // Entrada livre (preço por hora — linear, legado)
  precoEntradaHoraSemana        Decimal  @db.Decimal(10, 2) @default(10)
  precoEntradaHoraFimSemana     Decimal  @db.Decimal(10, 2) @default(12)
  // Entrada livre (tarifário por escalão — aplica-se a todos os dias)
  precoEntrada1h                Decimal  @db.Decimal(10, 2) @default(6)
  precoEntrada2h                Decimal  @db.Decimal(10, 2) @default(10)
  // Entrada livre: hora adicional (ex.: 1h extra = 5€)
  precoEntradaHoraAdicional     Decimal  @db.Decimal(10, 2) @default(5)
  // Mínimos de crianças por nº de aniversariantes
  // JSON: [{ "aniversariantes": 1, "minimo": 10 }, { "aniversariantes": 2, "minimo": 15 }, { "aniversariantes": 3, "minimo": 20 }]
  minimosCriancasPorAniversariante Json?
  // Meias (compra obrigatória no parque)
  precoMeias                    Decimal  @db.Decimal(10, 2) @default(2)
  // Excesso de tempo
  precoExcessoFixo              Decimal  @db.Decimal(10, 2) @default(5)
  // Caução por defeito (valor sugerido ao criar reserva — sobrescrevível)
  caucaoDefault                 Decimal  @db.Decimal(10, 2) @default(40)
  // Lanche em entrada livre (suplemento por pessoa quando temLanche = true)
  precoLancheEntrada            Decimal  @db.Decimal(10, 2) @default(3)
  // Valor/hora default para monitores (usado quando o monitor não tem valor individual)
  valorHoraMonitorDefault       Decimal? @db.Decimal(10, 2)
  // Durações default
  duracaoDefaultFestaMin        Int      @default(135) // 2h15m
  duracaoExcessoBlocoMin        Int      @default(30)
  createdAt                     DateTime @default(now())
  updatedAt                     DateTime @updatedAt

  @@map("configuracao_preco")
}

// ============================================
// RESERVAS (unificado com Festa)
// ============================================

model Reserva {
  id              String        @id @default(cuid())
  data            DateTime
  horario         String        // HH:MM
  duracaoMinutos  Int
  numCriancas     Int           @default(0)
  notas           String?       @db.Text
  estado          EstadoReserva @default(RESERVA)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  // ── Sala do Lanche (FK opcional para SalaLanche) ──
  salaLancheId    String?

  // Runtime fields (preenchidos quando estado passa a EM_CURSO)
  inicioEm        DateTime?
  fimPrevisto     DateTime?
  fimReal         DateTime?
  cacifosHistorico Json?

  // ── Novos campos da festa ────────────────
  tema              String?
  previsaoCriancas  Int?
  cor               String?
  bolo              TipoBolo?
  boloTema          String?
  boloQuantidade    Int?
  numCriancasConfirmadas Int?

  // Notas por equipa
  notasCacifos      String?  @db.Text
  notasLanche       String?  @db.Text

  // Observações
  observacoesGerais    String?  @db.Text
  observacoesLesoes    String?  @db.Text
  observacoesBrindes   String?  @db.Text
  observacoesBrindesPais String?  @db.Text
  outrosExtras         String?  @db.Text

  // ── Lanche ──
  estadoLanche         EstadoLanche  @default(NAO_INICIADO)
  horaLanche           String?       // HH:MM — hora planeada do lanche

  // Pagamento
  metodoPagamento     MetodoPagamento?
  valorPago           Decimal?          @db.Decimal(10, 2)
  pago                Boolean           @default(false)
  referenciaPagamento String?

  // Pagamento dividido (até 2 métodos — o restante pode ser pago de outra forma)
  metodoPagamento2    MetodoPagamento?
  valorPago2          Decimal?          @db.Decimal(10, 2)

  // Caução
  caucao              EstadoCaucao      @default(NAO_PAGA)
  valorCaucao         Decimal?          @db.Decimal(10, 2)

  // Excesso (preenchido quando estado passa a CONCLUIDA)
  excessoMinutos      Int?              @default(0)
  custoExcesso        Decimal?          @db.Decimal(10, 2)
  custoTotalFinal     Decimal?          @db.Decimal(10, 2)
  pagoExcesso         Boolean           @default(false)

  // Desconto
  descontoPercentagem Int?
  descontoMotivo      String?

  // ── Meias (compra obrigatória no parque) ──
  meiasQuantidade     Int?
  meiasPrecoUnit      Decimal?          @db.Decimal(10, 2)

  // ── Preço por criança (cálculo aplicado) ──
  precoCriancaAplicado Decimal?         @db.Decimal(10, 2)
  minimoCriancas       Int?

  // ── Relações ──────────────────────────
  clienteId       String
  cliente         Cliente       @relation(fields: [clienteId], references: [id])

  localId         String
  local           Local         @relation(fields: [localId], references: [id])

  // Sala do lanche (opcional — tabela separada SalaLanche)
  salaLanche      SalaLanche?   @relation(fields: [salaLancheId], references: [id])

  // Relations
  menu            Menu?
  extras          ReservaExtra[]
  cacifos         Cacifo[]
  monitores       ReservaMonitor[]
  etapas          ReservaEtapa[]
  participantes   Participante[]
  aniversariantes ReservaAniversariante[]

  @@index([data, localId])
  @@index([estado])
  @@map("reserva")
}

model ReservaExtra {
  id                String  @id @default(cuid())
  reservaId         String
  extraId           String
  quantidade        Int     @default(1)
  textoPersonalizado String? // Texto livre quando extra.requerTexto = true
  reserva           Reserva @relation(fields: [reservaId], references: [id], onDelete: Cascade)
  extra             Extra   @relation(fields: [extraId], references: [id], onDelete: Cascade)

  @@unique([reservaId, extraId])
  @@map("reserva_extra")
}

model ReservaMonitor {
  id        String  @id @default(cuid())
  reservaId String
  monitorId String
  reserva   Reserva @relation(fields: [reservaId], references: [id], onDelete: Cascade)
  monitor   Monitor @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  @@unique([reservaId, monitorId])
  @@map("reserva_monitor")
}

// Pivot M:N — Reserva ↔ Aniversariante (múltiplos aniversariantes por festa)
model ReservaAniversariante {
  id              String        @id @default(cuid())
  reservaId       String
  aniversarianteId String
  reserva         Reserva       @relation(fields: [reservaId], references: [id], onDelete: Cascade)
  aniversariante  Aniversariante @relation(fields: [aniversarianteId], references: [id], onDelete: Cascade)

  @@unique([reservaId, aniversarianteId])
  @@map("reserva_aniversariante")
}

// ============================================
// ETAPAS DE FESTA (configuráveis)
// ============================================

model EtapaFesta {
  id          String    @id @default(cuid())
  nome        String
  descricao   String?   @db.Text
  ordem       Int       @default(0)
  icone       String?
  activo      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  reservas    ReservaEtapa[]

  @@map("etapa_festa")
}

model ReservaEtapa {
  id          String    @id @default(cuid())
  reservaId   String
  etapaId     String
  concluida   Boolean   @default(false)
  concluidaEm DateTime?

  reserva     Reserva     @relation(fields: [reservaId], references: [id], onDelete: Cascade)
  etapa       EtapaFesta @relation(fields: [etapaId], references: [id], onDelete: Cascade)

  @@unique([reservaId, etapaId])
  @@map("reserva_etapa")
}

// ============================================
// PARTICIPANTES (crianças na festa)
// ============================================

model Participante {
  id        String   @id @default(cuid())
  nome      String
  presente  Boolean  @default(false)
  cacifoId  String?  @unique
  reservaId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reserva   Reserva  @relation(fields: [reservaId], references: [id], onDelete: Cascade)
  cacifo    Cacifo?  @relation(fields: [cacifoId], references: [id])

  @@map("participante")
}

// ============================================
// CACIFOS
// ============================================

model Cacifo {
  id              String            @id @default(cuid())
  numero          Int               @unique
  nome            String?
  estado          EstadoCacifo      @default(LIVRE)
  notas           String?           @db.Text
  criancas        String?
  // Histórico de ocupações (preservado quando o cacifo é libertado)
  historico       Json?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  configuracaoId  String
  configuracao    ConfiguracaoCacifo @relation(fields: [configuracaoId], references: [id])

  reservaId       String?
  reserva         Reserva?          @relation(fields: [reservaId], references: [id])

  participante    Participante?
  entradaLivre    EntradaLivre?

  @@index([estado])
  @@map("cacifo")
}

// ============================================
// MENUS (simplificado — nome + preço)
// ============================================

model Menu {
  id          String   @id @default(cuid())
  nome        String
  preco       Decimal  @db.Decimal(10, 2) @default(0)
  notas       String?  @db.Text
  // Notas de lanche/alergias (visível à conta LANCHE)
  notasLanche String?  @db.Text
  // Itens do lanche (estruturado, opcional)
  itensLanche Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  reservaId String   @unique
  reserva   Reserva  @relation(fields: [reservaId], references: [id], onDelete: Cascade)

  @@map("menu")
}

// ============================================
// MARKETING — Campanhas & Newsletter
// ============================================

model Segmento {
  id        String   @id @default(cuid())
  nome      String
  descricao String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contactos ContactoSegmento[]
  campanhas Campanha[]

  @@map("segmento")
}

model NewsletterContacto {
  id        String   @id @default(cuid())
  optOut    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clienteId String  @unique
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  segmentos ContactoSegmento[]

  @@map("newsletter_contacto")
}

model ContactoSegmento {
  id         String             @id @default(cuid())
  contactoId String
  segmentoId String
  contacto   NewsletterContacto @relation(fields: [contactoId], references: [id], onDelete: Cascade)
  segmento   Segmento           @relation(fields: [segmentoId], references: [id], onDelete: Cascade)

  @@unique([contactoId, segmentoId])
  @@map("contacto_segmento")
}

model Campanha {
  id           String          @id @default(cuid())
  tipo         TipoCampanha
  estado       EstadoCampanha  @default(RASCUNHO)
  assunto      String?
  mensagem     String          @db.Text
  segmentoId   String?
  segmento     Segmento?       @relation(fields: [segmentoId], references: [id])
  agendadaPara DateTime?
  enviadaEm    DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  envios       EnvioCampanha[]

  @@index([estado])
  @@map("campanha")
}

model EnvioCampanha {
  id           String    @id @default(cuid())
  campanhaId   String
  campanha     Campanha  @relation(fields: [campanhaId], references: [id], onDelete: Cascade)
  contactoId   String
  enviadoEm    DateTime  @default(now())
  aberto       Boolean   @default(false)
  abertoEm     DateTime?

  @@index([campanhaId])
  @@map("envio_campanha")
}

// ============================================
// SISTEMA — Audit Log & Notas Rápidas
// ============================================

model AuditLog {
  id        String   @id @default(cuid())
  accao     String
  detalhes  Json?
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
  @@map("audit_log")
}

model NotaRapida {
  id        String   @id @default(cuid())
  conteudo  String   @db.Text
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("nota_rapida")
}

// ============================================
// RBAC — Permissões HARDCODED (sem modelo na BD)
// ============================================
// As permissões são definidas em apps/web/src/lib/permissoes.ts
// (matriz fixa por FuncaoUtilizador). Não há tabela na base de dados.

// ============================================
// EXCEÇÕES DE CALENDÁRIO (feriados + dias bloqueados)
// ============================================
// Uma exceção por data. FERIADO afecta o preço (tarifa fim-de-semana);
// BLOQUEADO impede criar festas. Ambos podem coexistir (afectaPreco + bloqueiaReserva).

model ExcecaoCalendario {
  id               String                 @id @default(cuid())
  data             DateTime               @db.Date
  tipo             TipoExcecaoCalendario
  nome             String
  afectaPreco      Boolean                @default(true)
  bloqueiaReserva  Boolean                @default(false)
  recorrenciaAnual Boolean                @default(false)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  @@unique([data])
  @@map("excecao_calendario")
}

// ============================================
// SLOTS DE HORÁRIO (predefinidos para festas)
// ============================================

model SlotHorario {
  id                String   @id @default(cuid())
  horaInicio        String   // HH:MM
  duracaoMin        Int      // default 135 (2h15m)
  activo            Boolean  @default(true)
  ordem             Int      @default(0)
  // ── Defaults aplicados ao criar uma festa neste slot ──
  corDefault        String?  // Cor sugerida para a festa (ex: "#0095C8")
  horaLancheDefault String?  // HH:MM — hora sugerida do lanche
  salaLancheId      String?  // FK opcional para SalaLanche
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Sala do lanche sugerida para festas neste slot
  salaLanche        SalaLanche? @relation(fields: [salaLancheId], references: [id])

  @@map("slot_horario")
}

// ============================================
// ENTRADAS LIVRES (Walk-in / Open Play)
// ============================================

model EntradaLivre {
  id              String              @id @default(cuid())
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  // ── Crianças (flexível — pode ser 1 ou mais) ──
  criancas        Json                // Array de { nome: string, idade?: number }

  // ── Dados do Encarregado ────────────
  encarregadoNome String
  encarregadoTelefone String
  encarregadoEmail String?

  // ── Cliente (base de contactos / marketing) ──
  clienteId String?
  cliente   Cliente? @relation(fields: [clienteId], references: [id])

  // ── Duração e Custo ─────────────────
  duracaoMinutos  Int
  custoHora       Decimal             @db.Decimal(10, 2)
  custoTotal      Decimal             @db.Decimal(10, 2)
  custoExcesso    Decimal?            @db.Decimal(10, 2)
  custoTotalFinal Decimal?            @db.Decimal(10, 2)

  // ── Timer / Runtime ─────────────────
  inicioEm        DateTime
  fimPrevisto     DateTime
  fimReal         DateTime?
  excessoMinutos  Int?                @default(0)

  // ── Estado ──────────────────────────
  estado          EstadoEntradaLivre  @default(ATIVA)

  // ── Pagamento ───────────────────────
  metodoPagamento MetodoPagamento?
  pago            Boolean             @default(false)
  pagoExcesso     Boolean             @default(false)

  // ── Pagamento dividido (até 2 métodos) ──
  metodoPagamento2 MetodoPagamento?
  valorPago2       Decimal?           @db.Decimal(10, 2)

  // ── Meias (compra obrigatória no parque) ──
  meiasQuantidade Int?
  meiasPrecoUnit  Decimal?            @db.Decimal(10, 2)

  // ── Cacifo (opcional) ───────────────
  cacifoId        String?             @unique
  cacifo          Cacifo?             @relation(fields: [cacifoId], references: [id])

  // ── Observações ─────────────────────
  observacoes     String?  @db.Text
  observacoesLesoes String?           @db.Text

  // ── Lanche ──
  temLanche       Boolean            @default(false) // Se a entrada inclui lanche
  estadoLanche    EstadoLanche       @default(NAO_INICIADO)
  horaLanche      String?            // HH:MM — hora planeada do lanche

  // ── Adultos (encarregados que acompanham e pagam) ──
  numAdultos      Int                @default(0) // Nº de adultos que entram e pagam

  // ── Extras (opcional) ───────────────
  extras          EntradaLivreExtra[]

  @@index([estado])
  @@index([inicioEm])
  @@map("entrada_livre")
}

model EntradaLivreExtra {
  id                String       @id @default(cuid())
  entradaLivreId    String
  extraId           String
  quantidade        Int          @default(1)
  textoPersonalizado String?
  entradaLivre      EntradaLivre @relation(fields: [entradaLivreId], references: [id], onDelete: Cascade)
  extra             Extra        @relation(fields: [extraId], references: [id])

  @@unique([entradaLivreId, extraId])
  @@map("entrada_livre_extra")
}

// ============================================
// NOTAS DIÁRIAS (manhã / tarde) — vista MONITOR
// ============================================
model NotaDiaria {
  id         String   @id @default(cuid())
  data       DateTime @unique
  notasManha String?  @db.Text
  notasTarde String?  @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([data])
  @@map("nota_diaria")
}

// ============================================
// SALAS DE LANCHE — tabela separada de Locais
// ============================================
// Espaços dedicados ao lanche das festas (ex: Sala 1, Sala 2).
// Usada como default nos Slots de Horário e associada às Reservas.

model SalaLanche {
  id        String   @id @default(cuid())
  nome      String
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  slots     SlotHorario[]
  reservas  Reserva[]

  @@map("sala_lanche")
}

